{
  "compilerOptions": {
    "outDir": "lib",
    "rootDir": "./src",
    "target": "ES2020",
    "module": "node16",
    "moduleResolution": "node16",
    "jsx": "react-jsx",
    "declaration": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["node"]
  },
  "include": ["src/**/*"]
}